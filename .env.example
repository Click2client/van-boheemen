# Publieke basis-URL van de site, zonder slash aan het eind.
# Voorbeeld: https://www.vanboheemen.nl
# Zet dezelfde URL in src/config/site.ts bij url.
NEXT_PUBLIC_SITE_URL=https://www.vanboheemen.nl

# Google Tag Manager-container. Laat leeg tot de container klaar is.
# Voorbeeld: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Zet op true om Tag Manager ook lokaal en op preview-omgevingen te laden.
# Laat leeg of gebruik false zodra de live site aan staat.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Openbare testsleutel van Cloudflare Turnstile. Deze sleutel slaagt altijd en is alleen bedoeld om lokaal te testen.
# Vervang hem door de sitekey uit het Cloudflare-dashboard voordat de site live gaat.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Geheime testsleutel van Cloudflare Turnstile. Hoort bij de testsleutel hierboven.
# Vervang hem door het secret uit het Cloudflare-dashboard. Deze waarde mag niet in de browser komen.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# API-sleutel van Resend. Laat leeg tot het versturen van mail is ingesteld.
# Zonder deze sleutel blijft de site werken; het formulier meldt dan dat verzenden nog niet is ingesteld.
RESEND_API_KEY=

# Afzender van de formuliermail. Moet op een domein staan dat bij Resend is geverifieerd.
# Voorbeeld: website@voorbeeldbedrijf.nl
CONTACT_FROM_EMAIL=

# Ontvanger van berichten uit het contactformulier.
# Voorbeeld: info@van-boheemen.nl
CONTACT_TO_EMAIL=
